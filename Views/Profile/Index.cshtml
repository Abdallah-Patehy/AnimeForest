@{
    ViewData["Title"] = "Profile";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">My Profile</h2>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Profile" asp-action="FavAnimes" class="card text-decoration-none shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-1">Favorites</h5>
                    <p class="card-text text-muted mb-0">Your favorite anime list</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Profile" asp-action="Planned" class="card text-decoration-none shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-1">Planned</h5>
                    <p class="card-text text-muted mb-0">Plan to watch</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Profile" asp-action="Watching" class="card text-decoration-none shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-1">Watching</h5>
                    <p class="card-text text-muted mb-0">Currently watching</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Profile" asp-action="Completed" class="card text-decoration-none shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-1">Completed</h5>
                    <p class="card-text text-muted mb-0">Finished anime</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Profile" asp-action="Dropped" class="card text-decoration-none shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-1">Dropped</h5>
                    <p class="card-text text-muted mb-0">Not interested / dropped</p>
                </div>
            </a>
        </div>
    </div>
</div>