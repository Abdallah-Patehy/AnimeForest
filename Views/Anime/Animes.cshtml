@model List<Anime>

<style>
    /* كود الـ CSS اللي بعته مع تعديلات بسيطة ليناسب الصور */
    .card {
        position: relative;
        width: 100%; /* عشان يملأ العمود */
        height: 400px; /* طول مناسب لبوستر الأنمي */
        background-color: #333;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
        border: none;
    }

    /* جعل صورة الأنمي خلفية للكارد */
    .anime-poster {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
    }

    .card:hover {
        transform: rotate(-3deg) scale(1.05); /* قللنا الدوران شوية عشان القراءة */
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    }

    .card__content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-45deg);
        width: 100%;
        height: 100%;
        padding: 20px;
        box-sizing: border-box;
        background-color: rgba(255, 255, 255, 0.95); /* شفافية بسيطة */
        opacity: 0;
        transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .card:hover .card__content {
        transform: translate(-50%, -50%) rotate(0deg);
        opacity: 1;
    }

    .card:hover .anime-poster {
        filter: blur(5px) brightness(0.5); /* تغبيش الصورة عند الوقوف عليها */
    }

    .card__title {
        margin: 0;
        font-size: 1.5rem;
        color: #ff0f7b; /* لون جذاب */
        font-weight: 700;
    }

    .card__description {
        margin: 10px 0 0;
        font-size: 14px;
        color: #333;
        line-height: 1.4;
    }

    .info-badge {
        font-size: 12px;
        background: #f89b29;
        color: white;
        padding: 2px 8px;
        border-radius: 5px;
        margin-right: 5px;
    }
    /* اجعل الرابط يغطي الكارد بالكامل بدون تغيير ألوان النصوص الافتراضية */
    .text-decoration-none {
        color: inherit;
    }

    .card__title {
        margin-bottom: 10px;
        line-height: 1.2;
        /* لو الاسم طويل جداً هيظهر ... */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .info-badge {
        display: inline-block;
        margin-bottom: 5px;
        background: linear-gradient(90deg, #f89b29, #ff0f7b);
        border: none;
    }
</style>

<div class="container mt-5">
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var a in Model)
        {
            <div class="col">
                @* الكارد بالكامل رابط لصفحة التفاصيل *@
                <a asp-controller="Anime" asp-action="AnimeDetails" asp-route-id="@a.Id" class="text-decoration-none">
                    <div class="card shadow-lg">
                        @* تأكد أن مسار الصورة مطابق لما حفظته في الكنترولر *@
                        <img src="~/images/@a.ImageUrl" class="anime-poster" alt="@a.Title" />

                        <div class="card__content text-center">
                            <h3 class="card__title">@a.Title</h3>

                            <div class="mt-2">
                                @* هنا بنعرض الـ Name بدل ما نعرض الـ Object نفسه *@
                                @if (a.AnimeGenres != null && a.AnimeGenres.Any())
                                {
                                    @foreach (var animeGenre in a.AnimeGenres)
                                    {
                                        <span class="info-badge">@animeGenre.Genre.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="info-badge">Unknown Genre</span>
                                }
                                <span class="info-badge">@(a.Studio?.Name ?? "Unknown Studio")</span>
                            </div>

                            <div class="mt-4">
                                <p class="text-dark fw-bold mb-1">@a.Status</p>
                                <p class="text-muted small">
                                    <i class="bi bi-play-circle"></i> @a.Episodes.Count() Episodes
                                </p>
                            </div>

                            <div class="mt-auto">
                                <span class="btn btn-sm btn-danger rounded-pill px-4 shadow">More Info</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>