@model Anime

@{
    ViewData["Title"] = "Edit Anime";
    var selectstudio = new SelectList((List<Studio>)ViewData["studioslist"], "Id", "Name");
    var genres = (List<Genre>)ViewData["genereslist"];
    var selectedIds = Model.AnimeGenres?.Select(x => x.GenreId).ToHashSet() ?? new HashSet<int>();

}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 bg-dark text-white">
                <div class="card-header bg-warning text-dark text-center">
                    <h4 class="mb-0 fw-bold">Edit Anime: @Model.Title</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="SaveEdit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />


                        <div class="row">
                            <div class="col-md-12 text-center mb-4">
                                <label class="d-block mb-2 text-info">Current Poster</label>
                                <img src="~/images/@Model.ImageUrl" class="img-thumbnail" style="height: 150px;" />
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="Title" class="form-label fw-bold">Anime Title</label>
                                <input asp-for="Title" class="form-control bg-secondary text-white border-0" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="Description" class="form-label fw-bold">Description</label>
                                <textarea asp-for="Description" class="form-control bg-secondary text-white border-0" rows="3"></textarea>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="StudioId" class="form-label fw-bold">Studio</label>
                                <select asp-for="StudioId" class="form-select bg-secondary text-white border-0" asp-items="selectstudio"></select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Genres</label>
                                @foreach (var genre in genres)
                                {
                                    var isChecked = selectedIds.Contains(genre.Id);

                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedGenreIds"
                                               value="@genre.Id"
                                               id="genre_@genre.Id"
                                               @(isChecked ? "checked" : "") />
                                        <label class="form-check-label" for="genre_@genre.Id">
                                            @genre.Name
                                        </label>
                                    </div>
                                }
                                @* <select asp-for="AnimeGenres" class="form-select bg-secondary text-white border-0" asp-items="genres"></select> *@
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EpisodeCount" class="form-label fw-bold">Episodes</label>
                                <input asp-for="EpisodeCount" type="number" class="form-control bg-secondary text-white border-0" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ReleaseYear" class="form-label fw-bold">Release Year</label>
                                <input asp-for="ReleaseYear" type="number" class="form-control bg-secondary text-white border-0" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label fw-bold">Status</label>
                                <select asp-for="Status" class="form-select bg-secondary text-white border-0">
                                    <option value="Ongoing">Ongoing</option>
                                    <option value="Completed">Completed</option>
                                </select>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="d-block mb-2 text-info">Current Poster</label>
                                <img src="~/images/@Model.ImageUrl" class="img-thumbnail mb-2" style="height: 150px;" />

                                <!-- الصورة القديمة محتاج تبعتها لو مش رافع جديدة -->
                                <input type="hidden" asp-for="ImageUrl" />

                                <label class="form-label fw-bold">Upload New Poster (اتركه فاضي لو مش عايز تغيير)</label>
                                <input type="file" name="ImageFile" class="form-control bg-secondary text-white border-0" accept="image/*" />
                            </div>
                        <div class="d-grid gap-2 mt-2">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold">Update Anime Info</button>
                            <a asp-action="Index" class="btn btn-link text-info">Cancel and Back</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>